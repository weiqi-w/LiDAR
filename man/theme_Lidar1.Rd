\name{theme_Lidar1}
\alias{theme_Lidar1}
\title{Create a labeled LiDAR plotting theme.}
\description{Create a labeled LiDAR plotting theme.}
\usage{
theme_Lidar1(x_text_angle = FALSE, ratio = NULL, axis_text_size = 14, axis_title_size = 14, legend_text_size = 14, legend_position = "right", margin_size = 35)
}
\arguments{
\item{x_text_angle}{Plot appearance setting for x text angle ; see the default value in Usage.}
\item{ratio}{Plot appearance setting for ratio ; see the default value in Usage.}
\item{axis_text_size}{Plot appearance setting for axis text size ; see the default value in Usage.}
\item{axis_title_size}{Plot appearance setting for axis title size ; see the default value in Usage.}
\item{legend_text_size}{Plot appearance setting for legend text size ; see the default value in Usage.}
\item{legend_position}{Plot appearance setting for legend position ; see the default value in Usage.}
\item{margin_size}{Plot appearance setting for margin size ; see the default value in Usage.}
}
\value{A ggplot theme or a list containing a coordinate system and theme.}
\seealso{\code{\link{LiDAR-package}}}
