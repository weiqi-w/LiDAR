\name{theme_LiDAR}
\alias{theme_LiDAR}
\title{Create a configurable LiDAR theme.}
\description{Create a configurable LiDAR theme.}
\usage{
theme_LiDAR(show_border = FALSE, show_xy_labels = FALSE, show_ticks = FALSE, show_tick_labels = FALSE, show_title = TRUE, show_xy = TRUE, show_legend = TRUE, text_size = 14, xlab_size = NULL, xlab_angle = NULL, ylab_size = NULL, ylab_angle = NULL, xtick_size = NULL, xtick_angle = NULL, ytick_size = NULL, ytick_angle = NULL, title_size = NULL, title_angle = NULL, legend_title_size = NULL, legend_text_size = NULL)
}
\arguments{
\item{show_border}{Plot appearance setting for show border ; see the default value in Usage.}
\item{show_xy_labels}{Plot appearance setting for show xy labels ; see the default value in Usage.}
\item{show_ticks}{Plot appearance setting for show ticks ; see the default value in Usage.}
\item{show_tick_labels}{Plot appearance setting for show tick labels ; see the default value in Usage.}
\item{show_title}{Plot appearance setting for show title ; see the default value in Usage.}
\item{show_xy}{Plot appearance setting for show xy ; see the default value in Usage.}
\item{show_legend}{Plot appearance setting for show legend ; see the default value in Usage.}
\item{text_size}{Plot appearance setting for text size ; see the default value in Usage.}
\item{xlab_size}{Plot appearance setting for xlab size ; see the default value in Usage.}
\item{xlab_angle}{Plot appearance setting for xlab angle ; see the default value in Usage.}
\item{ylab_size}{Plot appearance setting for ylab size ; see the default value in Usage.}
\item{ylab_angle}{Plot appearance setting for ylab angle ; see the default value in Usage.}
\item{xtick_size}{Plot appearance setting for xtick size ; see the default value in Usage.}
\item{xtick_angle}{Plot appearance setting for xtick angle ; see the default value in Usage.}
\item{ytick_size}{Plot appearance setting for ytick size ; see the default value in Usage.}
\item{ytick_angle}{Plot appearance setting for ytick angle ; see the default value in Usage.}
\item{title_size}{Plot appearance setting for title size ; see the default value in Usage.}
\item{title_angle}{Plot appearance setting for title angle ; see the default value in Usage.}
\item{legend_title_size}{Plot appearance setting for legend title size ; see the default value in Usage.}
\item{legend_text_size}{Plot appearance setting for legend text size ; see the default value in Usage.}
}
\value{A ggplot theme or a list containing a coordinate system and theme.}
\seealso{\code{\link{LiDAR-package}}}
